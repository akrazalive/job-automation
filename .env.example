# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real credentials.

# --- Dashboard storage backend ---
# "local" = read/write data/local_applications.json, no AWS needed at all.
#           Good for building/testing the dashboard before infra/aws is
#           deployed. This is the default.
# "aws"   = read/write the DynamoDB tables + S3 bucket created by
#           infra/aws/template.yaml.
STORAGE_BACKEND=local

# --- AWS (only needed when STORAGE_BACKEND=aws) ---
AWS_REGION=us-east-1
DYNAMODB_JOBS_TABLE=job-automation-jobs-prod
DYNAMODB_APPLICATIONS_TABLE=job-automation-applications-prod
S3_BUCKET_NAME=job-automation-resumes-<your-account-id>-prod
# Prefer `aws configure` (a named profile) or an IAM role over putting
# access keys in this file. If you must, never commit the resulting .env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Dashboard login (required to run the dashboard at all locally;
# on AWS these come from infra/aws/template.yaml's NoEcho parameters,
# not from this file) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-now
SESSION_SECRET=change-me-to-something-random

# --- Anthropic (optional - LLM-assisted bullet-phrasing tailoring in
# src/pipeline/ingest.py / src/tailoring/. NOT used by the dashboard
# itself. Costs real money per API call (roughly one per new job found) -
# omit this and tailoring falls back to the free deterministic
# skill-reorder mode automatically. See README "Enabling Claude-assisted
# resume tailoring".) ---
# ANTHROPIC_API_KEY=

# --- Site credentials (Phase 4/5 - not used by the dashboard; runs locally
# only, see TECHNICAL_PLAN.txt section 6) ---
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=
# INDEED_EMAIL=
# INDEED_PASSWORD=
